generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------
// ENUMS (17)
// ------------------------------------------------------------------------------

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum GoalType {
  LEARNING
  ACHIEVEMENT
  HABIT
  MAINTENANCE
}

enum ObjectiveStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TaskType {
  TASK
  LEARNING
  BUG
  IMPROVEMENT
}

enum CaptureStatus {
  PENDING
  PROCESSED
  ARCHIVED
}

enum CaptureCategory {
  IDEA
  TASK_CANDIDATE
  NOTE
  REMINDER
}

enum EventType {
  PERSONAL
  WORK
  BLOCKED
  REMINDER
  TASK_DEADLINE
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ActivityCategory {
  WORK
  LEARNING
  HEALTH_FITNESS
  PERSONAL
  REST
  CHORE
}

enum NotificationType {
  TASK_DUE
  DAILY_FOCUS_REMINDER
  WEEKLY_REVIEW_REMINDER
  CALENDAR_EVENT
  MILESTONE_DEADLINE
  SYSTEM
  HABIT_CHECKIN
}

enum NotificationSeverity {
  INFO
  WARNING
  URGENT
}

enum HabitType {
  GOOD
  BAD
}

enum HabitDifficulty {
  EASY
  MEDIUM
  HARD
  EXTREME
}

// ------------------------------------------------------------------------------
// CORE DOMAIN
// ------------------------------------------------------------------------------

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String?
  name           String?
  avatarUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  preference     UserPreference?
  areas          Area[]
  goals          Goal[]
  objectives     Objective[]
  projects       Project[]
  stages         Stage[]
  milestones     Milestone[]
  tasks          Task[]
  sessions       Session[]
  dailyFocuses   DailyFocus[]
  reviews        Review[]
  calendarEvents CalendarEvent[]
  activities     Activity[]
  captures       Capture[]
  notifications  Notification[]
  lifeIdentity    LifeIdentity?
  lifeVision      LifeVision?
  lifeChapters    LifeChapter[]
  lifeReflections LifeReflection[]
  habits          Habit[]
  habitTasks      HabitTask[]
  habitLogs       HabitLog[]
  habitStreaks    HabitStreak[]
  trackedHabits   TrackedHabit[]
  habitEvents     HabitEvent[]
  habitOutbox     HabitNotificationOutbox[]
  triggers        Trigger[]
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  theme               Theme    @default(SYSTEM)
  weekStartDay        Int      @default(1)
  dailyFocusLimit     Int      @default(5)
  enableNotifications Boolean  @default(true)
  enableAiAssistance  Boolean  @default(true)
  timezone            String   @default("Asia/Jakarta")
  defaultReminderMinutes Int   @default(15)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// LIFE DOMAIN
// ------------------------------------------------------------------------------

model Area {
  id          String     @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String     @default("#6366f1")
  icon        String     @default("compass")
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       Goal[]
  projects    Project[]
  tasks       Task[]
  activities  Activity[]
  chapterFocuses ChapterFocusArea[]
  habits      Habit[]
  trackedHabits TrackedHabit[]

  @@unique([userId, name])
  @@index([userId, order])
  @@index([userId, isActive])
}

model Goal {
  id          String      @id @default(cuid())
  userId      String
  areaId      String?
  chapterId   String?
  title       String
  description String?
  type        GoalType    @default(LEARNING)
  status      GoalStatus  @default(ACTIVE)
  priority    Priority    @default(MEDIUM)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?       @relation(fields: [areaId], references: [id], onDelete: Restrict)
  chapter     LifeChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  stages      Stage[]
  projects    Project[]
  objectives  Objective[]
  reviews     Review[]
  tasks       Task[]
  trackedHabits TrackedHabit[]

  @@index([userId, status])
  @@index([userId, areaId])
  @@index([userId, chapterId])
  @@index([userId, targetDate])
}

model Objective {
  id           String          @id @default(cuid())
  userId       String
  goalId       String
  title        String
  description  String?
  targetValue  Float           @default(100.0)
  currentValue Float           @default(0.0)
  unit         String          @default("%")
  status       ObjectiveStatus @default(ACTIVE)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal         Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, goalId])
  @@index([userId, status])
}

model Project {
  id             String          @id @default(cuid())
  userId         String
  goalId         String?
  areaId         String?
  title          String
  description    String?
  status         ProjectStatus   @default(PLANNING)
  priority       Priority        @default(MEDIUM)
  startDate      DateTime?
  targetDate     DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  area           Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  milestones     Milestone[]
  tasks          Task[]
  calendarEvents CalendarEvent[]
  activities     Activity[]

  @@index([userId, status])
  @@index([userId, goalId])
  @@index([userId, areaId])
  @@index([userId, targetDate])
}

// ------------------------------------------------------------------------------
// PROGRESS DOMAIN
// ------------------------------------------------------------------------------

model Stage {
  id          String      @id @default(cuid())
  userId      String
  goalId      String
  name        String
  description String?
  order       Int         @default(0)
  status      StageStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([userId, goalId, order])
  @@index([userId, status])
}

model Milestone {
  id          String          @id @default(cuid())
  userId      String
  projectId   String
  title       String
  description String?
  order       Int             @default(0)
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([userId, projectId, order])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model Task {
  id             String          @id @default(cuid())
  userId         String
  title          String
  description    String?
  type           TaskType        @default(TASK)
  priority       Priority        @default(MEDIUM)
  status         TaskStatus      @default(TODO)

  // Structural Parent Relations (At least one must be non-null)
  stageId        String?
  milestoneId    String?
  projectId      String?
  areaId         String?

  // Shortcut lookup for fast Goal-level queries
  goalId         String?

  estimatedHours Float           @default(0.0)
  actualHours    Float           @default(0.0)
  dueDate        DateTime?
  scheduledDate  DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage          Stage?          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  milestone      Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area           Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goal           Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)

  sessions       Session[]
  dailyFocuses   DailyFocus[]
  calendarEvents CalendarEvent[]
  activities     Activity[]

  @@index([userId, status])
  @@index([userId, stageId])
  @@index([userId, milestoneId])
  @@index([userId, projectId])
  @@index([userId, goalId])
  @@index([userId, areaId])
  @@index([userId, dueDate])
  @@index([userId, scheduledDate])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  taskId          String
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  activity        String?
  understanding   Int?
  obstacle        String?
  nextAction      String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Enforced at database level via PostgreSQL Partial Unique Index:
  // CREATE UNIQUE INDEX "idx_unique_active_session_per_user" ON "Session" ("userId") WHERE "endedAt" IS NULL;
  @@index([userId, taskId])
  @@index([userId, startedAt])
  @@index([userId, endedAt])
}

model DailyFocus {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  taskId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, date, taskId])
  @@index([userId, date, order])
  @@index([userId, taskId])
}

model Review {
  id             String   @id @default(cuid())
  userId         String
  goalId         String
  periodStart    DateTime
  periodEnd      DateTime
  learningHours  Float    @default(0.0)
  tasksCompleted Int      @default(0)
  understanding  Float?
  wentWell       String?
  difficulties   String?
  improvements   String?
  nextFocus      String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([userId, goalId, periodStart, periodEnd])
  @@index([userId, goalId])
  @@index([userId, periodStart])
}

// ------------------------------------------------------------------------------
// TIME DOMAIN
// ------------------------------------------------------------------------------

model CalendarEvent {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isAllDay    Boolean        @default(false)
  eventType   EventType      @default(PERSONAL)
  recurrence  RecurrenceType @default(NONE)
  location    String?
  taskId      String?
  projectId   String?
  reminderMinutes   Int?      // per-event override; null = pakai UserPreference.defaultReminderMinutes
  ignoreQuietHours  Boolean  @default(false) // true = kirim reminder meski quiet hours (untuk alarm pagi)
  isCompleted       Boolean  @default(false)
  completedAt       DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, startTime, endTime])
  @@index([userId, eventType])
  @@index([userId, taskId])
}

model Activity {
  id                 String           @id @default(cuid())
  userId             String
  title              String
  category           ActivityCategory @default(WORK)
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  productivityRating Int?
  energyLevel        Int?
  notes              String?
  taskId             String?
  projectId          String?
  areaId             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  task               Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  area               Area?            @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId, startTime, endTime])
  @@index([userId, category])
  @@index([userId, areaId])
  @@index([userId, taskId])
}

// ------------------------------------------------------------------------------
// CAPTURE DOMAIN
// ------------------------------------------------------------------------------

model Capture {
  id              String          @id @default(cuid())
  userId          String
  content         String
  status          CaptureStatus   @default(PENDING)
  category        CaptureCategory @default(TASK_CANDIDATE)
  convertedTaskId String?
  convertedGoalId String?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ------------------------------------------------------------------------------
// NOTIFICATIONS DOMAIN
// ------------------------------------------------------------------------------

model Notification {
  id         String               @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType     @default(SYSTEM)
  severity   NotificationSeverity @default(INFO)
  isRead     Boolean              @default(false)
  readAt     DateTime?
  linkUrl    String?
  entityType String?
  entityId   String?
  createdAt  DateTime             @default(now())

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

// ------------------------------------------------------------------------------
// IDENTITY & DIRECTION DOMAIN
// ------------------------------------------------------------------------------

model LifeIdentity {
  id               String   @id @default(cuid())
  userId           String   @unique
  bio              String?
  currentSituation String?
  coreValues       Json?
  principles       Json?
  strengths        String[]
  growthAreas      String[]
  importantRoles   Json?
  aspirations      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LifeVision {
  id               String   @id @default(cuid())
  userId           String   @unique
  statement        String
  desiredIdentity  String?
  desiredLifestyle String?
  targetSkills     String[]
  purposeReason    String?
  timeHorizonYears Int?     @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LifeChapter {
  id              String             @id @default(cuid())
  userId          String
  title           String
  description     String?
  themeColor      String             @default("#8B5CF6")
  icon            String             @default("compass")
  startDate       DateTime           @default(now())
  targetEndDate   DateTime?
  actualEndDate   DateTime?
  isActive        Boolean            @default(true)
  mainIntent      String?
  reflectionNotes String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusAreas      ChapterFocusArea[]
  goals           Goal[]
  reflections     LifeReflection[]

  @@index([userId, isActive])
  @@index([userId, startDate])
}

model ChapterFocusArea {
  id        String      @id @default(cuid())
  chapterId String
  areaId    String?
  title     String
  intention String?
  order     Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  chapter   LifeChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  area      Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([chapterId, order])
  @@index([chapterId, areaId])
}

model LifeReflection {
  id                   String       @id @default(cuid())
  userId               String
  chapterId            String?
  title                String       @default("Refleksi Arah Hidup")
  date                 DateTime     @default(now())
  recentFocusNotes     String?
  meaningfulActivities String?
  progressNotes        String?
  lifeChanges          String?
  alignmentAssessment  String?
  adjustmentsNeeded    String?
  nextFocus            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter              LifeChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, chapterId])
}

// ------------------------------------------------------------------------------
// HABIT DOMAIN
// ------------------------------------------------------------------------------

model Habit {
  id               String          @id @default(cuid())
  userId           String
  title            String
  description      String?
  type             HabitType       @default(GOOD)
  difficulty       HabitDifficulty @default(MEDIUM)
  color            String          @default("#8B5CF6")
  icon             String          @default("zap")
  areaId           String?
  isActive         Boolean         @default(true)

  // Evaluation & Target
  checkInTime      String          @default("06:00")
  targetDays       Int?

  // BAD habit specific
  triggerNotes     String?
  replacementHabit String?
  whyQuit          String?

  // GOOD habit specific (Cue-Routine-Reward)
  cue              String?
  reward           String?

  startDate        DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  area             Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  phases           HabitPhase[]
  tasks            HabitTask[]
  logs             HabitLog[]
  streaks          HabitStreak[]

  @@index([userId, type])
  @@index([userId, isActive])
  @@index([userId, areaId])
}

model HabitTask {
  id          String   @id @default(cuid())
  userId      String
  habitId     String
  title       String
  description String?
  isCompleted Boolean  @default(false)
  category    String   @default("ACTION") // ACTION, BARRIER, REPLACEMENT, PROTOCOL
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, order])
  @@index([userId, habitId])
}

model HabitPhase {
  id               String    @id @default(cuid())
  habitId          String
  order            Int
  title            String
  description      String?
  targetDays       Int
  afterRelapseDays Int?      // Days of grace after completing phase
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  startedAt        DateTime?
  psychTip         String?

  habit            Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, order])
  @@index([habitId, isCompleted])
}

model HabitLog {
  id              String    @id @default(cuid())
  userId          String
  habitId         String
  date            DateTime  // Normalized to date only (no time)
  isSuccess       Boolean   @default(true)
  mood            Int?      // 1-5
  energyLevel     Int?      // 1-5
  notes           String?
  relapseTrigger  String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit           Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, date])
  @@index([userId, habitId])
  @@index([userId, date])
  @@index([habitId, date])
}

model HabitStreak {
  id          String    @id @default(cuid())
  userId      String
  habitId     String
  startDate   DateTime
  endDate     DateTime?
  days        Int       @default(0)
  isCurrent   Boolean   @default(true)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId, habitId, isCurrent])
  @@index([habitId, isCurrent])
}

// ------------------------------------------------------------------------------
// HABITS V2 DOMAIN (FASE 1)
// ------------------------------------------------------------------------------

enum HabitKind {
  BREAK
  BUILD
}

enum HabitMode {
  ABSTAIN
  REDUCE
}

enum HabitScheduleType {
  DAILY
  DAYS_OF_WEEK
  TIMES_PER_WEEK
}

enum HabitStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum HabitStage {
  CONTEMPLATION
  PREPARATION
  ACTION
  MAINTENANCE
}

enum HabitEventType {
  URGE
  LAPSE
  OCCURRENCE
  COMPLETION
  SKIP
}

enum HabitCheckinStatus {
  PENDING
  CLEAN
  LAPSED
  WITHIN_LIMIT
  OVER_LIMIT
  DONE
  SKIPPED
  MISSED
  UNCONFIRMED
}

model TrackedHabit {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId             String?
  area               Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  goalId             String?
  goal               Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  kind               HabitKind
  mode               HabitMode?
  name               String
  displayAlias       String?
  category           String?
  status             HabitStatus @default(ACTIVE)
  stage              HabitStage  @default(PREPARATION)
  identityStatement  String?
  timezone           String
  checkinLocalTime   String                       // "HH:mm"
  startedAt          DateTime    @db.Timestamptz(3)
  currentWindowStart DateTime    @db.Timestamptz(3)
  nextCheckinAt      DateTime?   @db.Timestamptz(3)
  privacyLevel       Int         @default(1)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)
  archivedAt         DateTime?   @db.Timestamptz(3)

  breakProfile        HabitBreakProfile?
  buildProfile        HabitBuildProfile?   @relation("HabitBuildProfileHabit")
  replacedByProfiles  HabitBuildProfile[]  @relation("HabitReplaces")
  events              HabitEvent[]
  checkins            HabitCheckin[]
  stats               HabitStats?
  outbox              HabitNotificationOutbox[]
  triggers            HabitTrigger[]
  copingPlans         CopingPlan[]
  milestones          HabitMilestone[]
  automaticitySurveys AutomaticitySurvey[]
  reminders           HabitReminder[]
  reflections         HabitReflection[]

  @@index([userId, status])
  @@index([userId, goalId])
}

model HabitBreakProfile {
  habitId              String       @id
  habit                TrackedHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  whyReasons           Json         @default("[]")
  futureSelfNote       String?
  rewardAnalysis       Json         @default("{}")
  baselinePerDay       Decimal?     @db.Decimal(8, 2)
  costPerOccurrence    Decimal?     @db.Decimal(12, 2)
  currency             String       @default("IDR")
  minutesPerOccurrence Int?
  reduceDailyLimit     Int?
  reduceStepPercent    Int?
  reduceStepEveryDays  Int?
  relapseLapseCount    Int          @default(3)
  relapseWindowDays    Int          @default(7)
  highRiskCategory     Boolean      @default(false)
  safetyAckAt          DateTime?    @db.Timestamptz(3)
  relapseAckAt         DateTime?    @db.Timestamptz(3)
  environmentChecklist Json         @default("[]")
}

model HabitEvent {
  id              String         @id @default(cuid())
  habitId         String
  habit           TrackedHabit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            HabitEventType
  occurredAt      DateTime       @db.Timestamptz(3)
  loggedAt        DateTime       @default(now()) @db.Timestamptz(3)
  quantity        Decimal        @default(1) @db.Decimal(8, 2)
  intensityBefore Int?
  intensityAfter  Int?
  outcome         String?        // RESISTED | GAVE_IN
  severity        String?        // SLIP | RELAPSE
  mood            Int?
  halt            String[]       @default([])
  locationLabel   String?
  withWhom        String?
  note            String?
  meta            Json           @default("{}")
  source          String         @default("APP")   // APP | CHECKIN | SOS | BACKFILL
  idempotencyKey  String?
  deletedAt       DateTime?      @db.Timestamptz(3)

  eventTriggers   HabitEventTrigger[]

  @@unique([userId, idempotencyKey])
  @@index([habitId, occurredAt(sort: Desc)])
}

model HabitCheckin {
  id             String             @id @default(cuid())
  habitId        String
  habit          TrackedHabit       @relation(fields: [habitId], references: [id], onDelete: Cascade)
  windowStart    DateTime           @db.Timestamptz(3)
  windowEnd      DateTime           @db.Timestamptz(3)
  periodDate     DateTime           @db.Date
  status         HabitCheckinStatus @default(PENDING)
  quantity       Decimal?           @db.Decimal(8, 2)
  mood           Int?
  note           String?
  notifiedAt     DateTime?          @db.Timestamptz(3)
  respondedAt    DateTime?          @db.Timestamptz(3)
  responseSource String?            // LIVE | BACKFILL | AUTO

  @@unique([habitId, periodDate])
  @@index([habitId, windowEnd(sort: Desc)])
}

model HabitStats {
  habitId            String       @id
  habit              TrackedHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  lastLapseAt        DateTime?    @db.Timestamptz(3)
  currentStreakDays  Int          @default(0)
  longestStreakDays  Int          @default(0)
  confirmedCleanDays Int          @default(0)
  totalLapses        Int          @default(0)
  urgesResisted      Int          @default(0)
  cleanRate30d       Decimal?     @db.Decimal(5, 2)
  consistency30d     Decimal?     @db.Decimal(5, 2)
  resilientStreak    Int          @default(0)
  moneySavedEst      Decimal?     @db.Decimal(14, 2)
  minutesSavedEst    Int?
  relapsePattern     Boolean      @default(false)
  recomputedAt       DateTime     @default(now()) @db.Timestamptz(3)
}

model HabitNotificationOutbox {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId     String?
  habit       TrackedHabit? @relation(fields: [habitId], references: [id], onDelete: Cascade)
  kind        String
  payload     Json
  scheduledAt DateTime      @db.Timestamptz(3)
  status      String        @default("PENDING")   // PENDING | SENT | FAILED | CANCELLED
  attempts    Int           @default(0)
  dedupeKey   String        @unique
  lastError   String?

  @@index([status, scheduledAt])
}

// ------------------------------------------------------------------------------
// HABITS V2 DOMAIN (FASE 2: Rencana, Pemicu, SOS, Keselamatan)
// ------------------------------------------------------------------------------

enum TriggerCategory {
  TIME
  PLACE
  PERSON
  EMOTION
  PHYSICAL
  ACTIVITY
  DEVICE
  OTHER
}

model Trigger {
  id          String          @id @default(cuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    TriggerCategory
  name        String
  description String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  habitTriggers HabitTrigger[]

  @@index([userId, category])
}

model HabitTrigger {
  id        String       @id @default(cuid())
  habitId   String
  habit     TrackedHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  triggerId String
  trigger   Trigger      @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  intensity Int          @default(3) // 1-5
  note      String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  copingPlans   CopingPlan[]
  eventTriggers HabitEventTrigger[]

  @@unique([habitId, triggerId])
  @@index([habitId])
}

model CopingPlan {
  id                 String        @id @default(cuid())
  habitId            String
  habit              TrackedHabit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitTriggerId     String?
  habitTrigger       HabitTrigger? @relation(fields: [habitTriggerId], references: [id], onDelete: SetNull)
  ifCondition        String
  thenAction         String
  replacementHabitId String?
  timesUsed          Int           @default(0)
  timesHelped        Int           @default(0)
  order              Int           @default(0)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  @@index([habitId, isActive])
  @@index([habitTriggerId])
}

model HabitEventTrigger {
  id             String       @id @default(cuid())
  eventId        String
  event          HabitEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  habitTriggerId String
  habitTrigger   HabitTrigger @relation(fields: [habitTriggerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([eventId, habitTriggerId])
  @@index([eventId])
  @@index([habitTriggerId])
}

model HabitMilestone {
  id           String       @id @default(cuid())
  habitId      String
  habit        TrackedHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  code         String       // STREAK_1..365, FIRST_URGE_RESISTED, etc.
  title        String
  achievedAt   DateTime     @db.Timestamptz(3)
  celebratedAt DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([habitId, code])
  @@index([habitId, achievedAt])
}

model SupportResource {
  id          String   @id @default(cuid())
  country     String   @default("ID")
  category    String   // GENERAL | SUBSTANCE | GAMBLING | CRISIS | MENTAL_HEALTH
  name        String
  contact     String
  description String?
  isVerified  Boolean  @default(true)
  verifiedAt  DateTime @db.Timestamptz(3)
  sourceUrl   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([country, category])
}

model HabitBuildProfile {
  habitId         String            @id
  habit           TrackedHabit      @relation("HabitBuildProfileHabit", fields: [habitId], references: [id], onDelete: Cascade)
  anchorText      String?
  tinyBehavior    String
  celebrationText String?
  versions        Json              @default("{}") // {"tiny": "..", "standard": "..", "stretch": ".."}
  scheduleType    HabitScheduleType @default(DAILY)
  daysOfWeek      Int[]             @default([])   // 1=Senin .. 7=Minggu
  timesPerWeek    Int?
  restDays        Int[]             @default([])
  replacesHabitId String?
  replacesHabit   TrackedHabit?     @relation("HabitReplaces", fields: [replacesHabitId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  @@index([replacesHabitId])
}

model AutomaticitySurvey {
  id         String       @id @default(cuid())
  habitId    String
  habit      TrackedHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  answeredAt DateTime     @default(now()) @db.Timestamptz(3)
  score      Int          // 1 to 7
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([habitId, answeredAt])
}

// ------------------------------------------------------------------------------
// HABITS V2 DOMAIN (FASE 4: Pengingat & Refleksi)
// ------------------------------------------------------------------------------

enum HabitReminderKind {
  CHECKIN
  EVENING_REFLECTION
  RISK_WINDOW
  WEEKLY_REVIEW
  ANCHOR
}

model HabitReminder {
  id         String            @id @default(cuid())
  habitId    String
  habit      TrackedHabit      @relation(fields: [habitId], references: [id], onDelete: Cascade)
  kind       HabitReminderKind
  localTime  String            // "HH:mm"
  daysOfWeek Int[]             @default([]) // 1=Senin .. 7=Minggu
  nextFireAt DateTime?         @db.Timestamptz(3)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  @@index([habitId, isActive])
  @@index([isActive, nextFireAt])
}

model HabitReflection {
  id          String       @id @default(cuid())
  habitId     String
  habit       TrackedHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  weekStart   DateTime     @db.Date
  summary     Json?
  question    String
  answer      String?
  submittedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([habitId, weekStart])
  @@index([habitId, weekStart(sort: Desc)])
}


