# Salin ke .env lalu isi nilai yang sesuai.
# PostgreSQL Connection (Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_progress_os?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/personal_progress_os?schema=public"

# Wajib di production. Gunakan nilai acak yang kuat, mis. `openssl rand -hex 24`.
# Bila kosong di production, aplikasi menolak membuat sesi (fail-closed).
AUTH_SECRET=change-me-generate-random-hex

# Kode akses login (satu-satunya gerbang otentikasi). Jangan pernah pakai nilai
# contoh di production. Bila kosong di production, login menolak dengan 503.
AUTH_ACCESS_CODE=change-me-strong-passphrase

# ------------------------------------------------------------------------------
# KANAL NOTIFIKASI EKSTERNAL (TELEGRAM & EMAIL) - 100% FREE
# ------------------------------------------------------------------------------

# Telegram Bot Notification (100% Gratis selamanya via @BotFather)
# 1. Buka @BotFather di Telegram, ketik /newbot, ikuti instruksi, copy token bot.
# 2. Chat bot Anda atau @userinfobot untuk mengetahui Chat ID Anda.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base URL aplikasi (untuk link klikable langsung ke task di Telegram/Email)
# Contoh production: https://myprogres.vercel.app
APP_URL=http://localhost:3000

# Email SMTP Notification (100% Gratis via Gmail App Password atau SMTP lain)
# Untuk Gmail: Buka Google Account -> Security -> 2-Step Verification -> App Passwords -> Buat App Password (16 karakter).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
NOTIFICATION_EMAIL_TO=your-email@gmail.com